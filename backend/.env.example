# ==============================================================================
# ChopSnap Environment Configuration
# ==============================================================================

# Mode: "auto" (tries live models, falls back cleanly to mock if offline),
#       "live" (strict live models), or "mock" (offline dev)
INFERENCE_MODE=auto

# ------------------------------------------------------------------------------
# 1. Vision Model (Open-Weight: Qwen2-VL, LLaVA, Llama-3.2-Vision)
# ------------------------------------------------------------------------------
# Provider: "ollama" or "openai_compatible"
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Model name to pull in Ollama: `ollama run qwen2-vl:7b` or `ollama run llava:13b`
VISION_MODEL_NAME=qwen2-vl:7b
VISION_TIMEOUT_SECONDS=45.0

# ------------------------------------------------------------------------------
# 2. Meta Muse Glimmer (30B Open-Weight Reasoning Model)
# ------------------------------------------------------------------------------
# Provider: "openai_compatible" (vLLM, Ollama /v1, LMDeploy, TGI) or "ollama"
MUSE_GLIMMER_PROVIDER=openai_compatible
# Default vLLM or Ollama v1 endpoint:
MUSE_GLIMMER_ENDPOINT=http://localhost:8000/v1
MUSE_GLIMMER_MODEL_NAME=meta/muse-glimmer-30b
# Optional API key if using an authenticated local or remote proxy
MUSE_GLIMMER_API_KEY=
MUSE_GLIMMER_TIMEOUT_SECONDS=60.0
