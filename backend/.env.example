# ==============================================================================
# ChopSnap Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary Unified AI Configuration (OpenAI-compatible endpoints / proxies)
# ------------------------------------------------------------------------------
AI_BASE_URL=
AI_API_KEY=
VISION_MODEL=
RECIPE_MODEL=

# ------------------------------------------------------------------------------
# General Inference Settings
# ------------------------------------------------------------------------------
# Modes: "auto" (attempts live models, falls back cleanly to mock if offline),
#        "live" (strict live models), or "mock" (offline dev)
INFERENCE_MODE=auto

# ------------------------------------------------------------------------------
# Fine-Grained Model Settings (Optional Overrides)
# ------------------------------------------------------------------------------
# Vision Provider: "ollama" or "openai_compatible"
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL_NAME=open-vision:7b
VISION_TIMEOUT_SECONDS=45.0

# Recipe Engine: "openai_compatible" or "ollama"
MUSE_GLIMMER_PROVIDER=openai_compatible
MUSE_GLIMMER_ENDPOINT=http://localhost:8000/v1
MUSE_GLIMMER_MODEL_NAME=meta/muse-spark-open
MUSE_GLIMMER_API_KEY=
MUSE_GLIMMER_TIMEOUT_SECONDS=60.0
