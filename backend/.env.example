# Primary OpenAI-compatible base URL for vision and recipe inference
AI_BASE_URL=

# Secret API key for OpenAI-compatible model provider
AI_API_KEY=

# Model name for food ingredient detection
VISION_MODEL=

# Model name for Nigerian culinary recipe synthesis
RECIPE_MODEL=

# Inference mode: "live" (strict live models, no mock fallback), "auto", or "mock"
INFERENCE_MODE=

# Deployment environment: "development" or "production" (disables /docs and /openapi.json)
ENVIRONMENT=

# Comma-separated allowed frontend origins for CORS without trailing slashes (e.g. https://chopsnap.vercel.app)
ALLOWED_ORIGINS=

# Maximum allowed requests per minute per visitor IP (default: 15)
RATE_LIMIT_PER_MINUTE=

# Maximum live AI calls allowed globally per UTC day to preserve credits (default: 300)
DAILY_AI_CALL_LIMIT=
